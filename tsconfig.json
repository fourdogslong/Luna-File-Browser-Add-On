{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@uaudio/luna-builder-sdk/global"],
    "paths": {
      "@uaudio/luna-builder-sdk": ["./types/luna-sdk/index.d.ts"],
      "@uaudio/luna-builder-sdk/global": ["./types/luna-global.d.ts"]
    }
  },
  "include": ["src", "types"]
}
